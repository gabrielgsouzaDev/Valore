# ─── Valore — variáveis de ambiente ───────────────────────────────────────────
# Copie este arquivo para `.env.local` e preencha os valores.
#   cp .env.example .env.local

# Token da API Brapi (https://brapi.dev) — usado pelas rotas de proxy em
# app/api/assets/* para buscar cotações de ações/FIIs/ETFs.
# Sem ele, a sincronização de preços retorna HTTP 500.
# Gere um token gratuito em: https://brapi.dev/dashboard
BRAPI_TOKEN=
